# Frontend (Vite build)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01
VITE_SANITY_READ_TOKEN=

# Sanity Studio (sanity/ subfolder)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Telegram insights bot (services/insights-bot)
TELEGRAM_BOT_TOKEN=
BOT_EDITOR_PIN=
BOT_WEBHOOK_SECRET=
BOT_PORT=8787
BOT_PUBLIC_URL=https://6e48a4f79211.vps.myjino.ru/api/bot

# SOCKS5 proxy for Telegram API (optional, e.g. if VPS cannot reach api.telegram.org)
TELEGRAM_PROXY_URL=socks5://user:pass@host:port
TELEGRAM_TIMEOUT_MS=60000

# Sanity write access (bot + seed script only — never in Vite)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_WRITE_TOKEN=

# Cursor SDK — «Улучшить текст» in bot
CURSOR_API_KEY=

# Optional: cover image generation
OPENAI_API_KEY=
